# Auto detect text files and perform LF normalization
* text=auto

# Explicitly declare text files
*.py text diff=python
*.md text diff=markdown
*.toml text
*.yml text
*.yaml text
*.json text
*.txt text

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text

# Jupyter Notebooks
*.ipynb text linguist-vendored=false
